# Copy to config/yam-local.env, replace both paths, then:
# source config/yam-local.env
# Use COLOR nodes that offer YUYV/MJPG 640x480@30; index numbers vary by device.
export YAM_CAMERA_LEFT='/dev/v4l/by-id/REPLACE_WITH_LEFT_COLOR_NODE'
export YAM_CAMERA_RIGHT='/dev/v4l/by-id/REPLACE_WITH_RIGHT_COLOR_NODE'
# Strict defaults; old laptop flow-only tests used 150 and 100 explicitly.
export CAMERA_MAX_AGE_MS=80
export CAMERA_MAX_SKEW_MS=50
# Optional storage root overrides (both preserve config.paths behavior):
# export FLASH_ALOHA_DATA_DIR='/absolute/path/to/datasets'
# export FLASH_ALOHA_LOG_DIR='/absolute/path/to/logs'
